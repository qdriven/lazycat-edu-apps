# ============================================================
# 基础设施版本锁定文件 —— 全仓库唯一的版本事实来源
# 升级流程：改这里 → 同步改 apps/*/lzc-manifest.yml 的 image tag
#           → git -C upstream/<repo> fetch && checkout 对应提交 → make pack
# ============================================================

# DeepTutor（上游 HKUDS/DeepTutor，GHCR tag 无 v 前缀）
DEEPTUTOR_VERSION=1.5.10
DEEPTUTOR_IMAGE=ghcr.io/hkuds/deeptutor:1.5.10

# OpenMAIC（上游 JoeyMyMan/OpenMAIC4course，自行构建）
OPENMAIC_VERSION=0.1.0

# 共享 PostgreSQL
POSTGRES_IMAGE=postgres:16-alpine

# 你的镜像命名空间（Docker Hub 用户名 / 私有 Registry 前缀）
# 用于 OpenMAIC 自建镜像与 copy-image 中转；按实际修改
REGISTRY_USER=qdriven
